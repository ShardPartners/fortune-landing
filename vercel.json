{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "klover.org" }],
      "destination": "https://www.klover.org/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/font/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
